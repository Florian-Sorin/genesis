# Exemple de variables d'environnement.
# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS commit .env (vérifier .gitignore).
#
# La liste exhaustive est maintenue dans docs/ARCHITECTURE.md section 9.
# Ajouter toute nouvelle variable ici ET dans ARCHITECTURE.md.

# --- App ---
# NODE_ENV=development
# APP_URL=http://localhost:3000

# --- Supabase ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Base de données (si direct) ---
# DATABASE_URL=

# --- Emails ---
# RESEND_API_KEY=

# --- Paiement ---
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=

# --- IA ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Analytics ---
# PLAUSIBLE_DOMAIN=
